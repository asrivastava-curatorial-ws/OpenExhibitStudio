            447
          ],
          "bind": "posted",
          "readonly": true
        },
        {
          "id": "caption",
          "name": "Caption",
          "kind": "text",
          "rect": [
            55,
            589,
            1160,
            90
          ],
          "text": "{posted_caption}",
          "font": 34,
          "color": "#eaf2f9"
        }
      ]
    }
  ],
  "variables": {
    "ink": [],
    "caption": "",
    "posted": [],
    "posted_caption": "Your drawing will appear here"
  },
  "rules": [
    {
      "id": "rule_1",
      "event": "change.caption",
      "actions": [
        {
          "op": "set",
          "target": "caption",
          "value": "$value"
        }
      ]
    },
    {
      "id": "rule_2",
      "event": "tap.post",
      "actions": [
        {
          "op": "set",
          "target": "posted",
          "value": "$ink"
        },
        {
          "op": "set",
          "target": "posted_caption",
          "value": "$caption"
        }
      ]
    },
    {
      "id": "rule_3",
      "event": "tap.clear",
      "actions": [
        {
          "op": "clear",
          "target": "ink",
          "value": 1
        },
        {
          "op": "set",
          "target": "caption",
          "value": ""
        }
      ]
    }
  ],
