  "variables": {
    "level": 0,
    "lamp": 0
  },
  "rules": [
    {
      "id": "rule_1",
      "event": "input.dial",
      "actions": [
        {
          "op": "set",
          "target": "level",
          "value": "$value"
        }
      ]
    },
    {
      "id": "rule_2",
      "event": "input.button",
      "actions": [
        {
          "op": "emit",
          "target": "tap.switch",
          "value": 1
        }
      ],
      "if": {
        "op": "==",
        "left": "$value",
        "right": 1
      }
    },
    {
      "id": "rule_3",
      "event": "tap.switch",
      "actions": [
        {
          "op": "add",
          "target": "lamp",
          "value": 1
        },
        {
          "op": "emit",
          "target": "lamp.check",
          "value": 1
        }
      ]
    },
    {
      "id": "rule_4",
      "event": "lamp.check",
      "actions": [
        {
          "op": "set",
          "target": "lamp",
          "value": 0
        }
      ],
      "if": {
        "op": "==",
        "left": "$lamp",
        "right": 2
      }
    },
    {
      "id": "rule_5",
      "event": "lamp.check",
      "actions": [
        {
          "op": "output",
          "target": "lamp",
          "value": "$lamp"
        }
      ]
    }
  ],
  "timelines": [],
