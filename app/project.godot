config_version=5
[application]
config/name="OpenExhibit Studio"
config/version="0.2.0"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/main_scene="res://studio/studio.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="OpenExhibitStudio"
config/icon="res://assets/icon.svg"
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/subwindows/embed_subwindows=false
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.044, 0.056, 0.083, 1)
[audio]
driver/enable_input=false
